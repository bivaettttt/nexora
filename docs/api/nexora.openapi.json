          "local_id",
          "version",
          "name",
          "email",
          "payment_status",
          "payment_version"
        ],
        "title": "CustomerRecord",
        "type": "object"
      },
      "Difference": {
        "properties": {
          "code": {
            "enum": [
              "UNREACHABLE",
              "MISSING",
              "IDENTIFIER_MISMATCH",
              "VERSION_LAG",
              "AHEAD",
              "FIELD_DRIFT",
              "PAYMENT_DRIFT",
              "CONTRACT"
            ],
            "title": "Code",
            "type": "string"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          },
          "target": {
            "enum": [
              "ERP",
              "CRM",
              "Billing"
            ],
            "title": "Target",
            "type": "string"
          }
        },
        "required": [
          "target",
          "code"
        ],
        "title": "Difference",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
